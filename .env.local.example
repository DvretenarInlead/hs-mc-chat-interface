# HubSpot OAuth App (Public App — required for user login)
# Create at: https://app.hubspot.com/developer → Apps → Create app
# Required scopes: oauth, crm.objects.contacts.read/write, crm.objects.companies.read/write,
#   crm.objects.deals.read, crm.objects.notes.read/write, crm.objects.tasks.write, crm.schemas.contacts.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# NOTE: No private app token needed — the MCP server uses each user's
# OAuth access token, so CRM actions are scoped to their HubSpot permissions.

# Anthropic
ANTHROPIC_API_KEY=

# Auth / Session
SESSION_SECRET=                   # 32+ char random string for JWT signing
NEXTAUTH_URL=http://localhost:3000

# Database — PostgreSQL connection string
# Local:  postgresql://user:password@localhost:5432/ri_chat
# DO:     auto-injected as ${db.DATABASE_URL} when using managed DB
DATABASE_URL=

# Encryption key for tokens at rest (REQUIRED — 32+ char random string, separate from SESSION_SECRET)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# CRM Access Mode
# "read_write" (default) — full CRM access: read, create notes/tasks, update records
# "read_only"           — safe mode: only CRM queries, all write tools are stripped
MCP_MODE=read_write

# App Config
NEXT_PUBLIC_APP_NAME="Relationship Intelligence"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Production (DigitalOcean) Notes ──
# 1. Set HUBSPOT_REDIRECT_URI to https://your-app.ondigitalocean.app/api/auth/callback
# 2. Set NEXTAUTH_URL and NEXT_PUBLIC_APP_URL to your production URL
# 3. Generate unique values for SESSION_SECRET and TOKEN_ENCRYPTION_KEY:
#      openssl rand -hex 32
# 4. DATABASE_URL is auto-injected by DigitalOcean when you attach a managed PostgreSQL
# 5. After first deploy, run migrations:
#      doctl apps console YOUR_APP_ID -- npx prisma migrate deploy
#      doctl apps console YOUR_APP_ID -- npx tsx prisma/seed.ts
