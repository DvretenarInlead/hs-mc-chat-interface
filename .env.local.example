# HubSpot OAuth App
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# HubSpot MCP
HUBSPOT_PRIVATE_APP_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Auth / Session
SESSION_SECRET=                   # 32+ char random string for JWT signing
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=                     # Postgres connection string

# Encryption key for tokens at rest (REQUIRED — 32+ char random string, separate from SESSION_SECRET)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# App Config
NEXT_PUBLIC_APP_NAME="Relationship Intelligence"
NEXT_PUBLIC_APP_URL=http://localhost:3000
