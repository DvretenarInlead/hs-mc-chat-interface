generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  hubspotUserId   String     @unique
  email           String     @unique
  name            String
  hubspotPortalId String
  role            UserRole   @default(VIEWER)
  accessToken     String     // HubSpot access token (encrypted at rest)
  refreshToken    String     // HubSpot refresh token (encrypted at rest)
  tokenExpiresAt  DateTime
  chatPinHash     String?    // PBKDF2-hashed chat access PIN
  chatPinRequired Boolean    @default(false) // Whether PIN is required to access chat
  chatPinSetAt    DateTime?  // When the PIN was last set/changed
  chatPinFailures Int        @default(0) // Consecutive failed PIN attempts
  chatPinLockedUntil DateTime? // Lockout after too many failures
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sessions        Session[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id               String      @id @default(cuid())
  userId           String
  userEmail        String
  action           AuditAction
  toolName         String
  inputSummary     String
  outputSummary    String?
  recordType       String?
  recordId         String?
  status           LogStatus   @default(PENDING)
  requiresApproval Boolean     @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  messages  Json     @default("[]")  // Encrypted JSON of chat messages
  encrypted Boolean  @default(false) // Whether messages field is encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model GovernanceRule {
  id          String     @id @default(cuid())
  name        String
  description String?
  toolName    String
  action      RuleAction
  conditions  Json?
  appliesTo   UserRole[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("governance_rules")
}

enum UserRole {
  ADMIN
  POWER_USER
  VIEWER
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
}

enum RuleAction {
  ALLOW
  REQUIRE_CONFIRM
  BLOCK
}

enum LogStatus {
  PENDING
  COMPLETED
  APPROVED
  REJECTED
  BLOCKED
}

model SensitivityRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  pattern     String   // Regex pattern to detect sensitive data
  category    SensitivityCategory
  maskStyle   MaskStyle @default(FULL)
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false) // Built-in rules cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sensitivity_rules")
}

enum SensitivityCategory {
  EMAIL
  PHONE
  SSN
  CREDIT_CARD
  API_KEY
  CUSTOM
}

enum MaskStyle {
  FULL      // ********
  PARTIAL   // jo***@***.com
  REDACT    // [REDACTED]
}

model IpAllowlistEntry {
  id          String   @id @default(cuid())
  cidr        String   // IP or CIDR range (e.g. "10.0.0.0/24" or "192.168.1.1")
  label       String?  // Description (e.g. "Office VPN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ip_allowlist")
}

model SecurityEvent {
  id          String            @id @default(cuid())
  userId      String?
  userEmail   String?
  eventType   SecurityEventType
  detail      String            // Human-readable description
  ipAddress   String?
  userAgent   String?
  metadata    Json?             // Additional structured data
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

enum SecurityEventType {
  PIN_VERIFIED
  PIN_FAILED
  PIN_LOCKED_OUT
  PIN_UNLOCKED
  PIN_SET
  PIN_CHANGED
  PIN_RESET_BY_ADMIN
  PIN_REMOVED
  CHAT_LOCKED
  CHAT_UNLOCKED
  IP_BLOCKED
  SESSION_EXPIRED
  EXPORT_BLOCKED
  BULK_ACCESS_BLOCKED
}

model SensitiveField {
  id          String       @id @default(cuid())
  objectType  String       // e.g. "contacts", "companies", "deals"
  fieldName   String       // HubSpot field name (e.g. "phone", "mobilephone")
  label       String       // Display label (e.g. "Mobile Phone")
  maskStyle   MaskStyle    @default(PARTIAL)
  minRole     UserRole     @default(ADMIN) // Minimum role to see unmasked
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([objectType, fieldName])
  @@map("sensitive_fields")
}

model DataRetentionPolicy {
  id                    String   @id @default(cuid())
  chatSessionMaxDays    Int      @default(90)   // Delete chat sessions older than N days
  auditLogMaxDays       Int      @default(365)  // Delete audit logs older than N days
  securityEventMaxDays  Int      @default(365)  // Delete security events older than N days
  isActive              Boolean  @default(true)
  lastRunAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("data_retention_policies")
}
