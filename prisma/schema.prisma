generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  role            UserRole   @default(VIEWER)
  portalId        String?    // Assigned HubSpot portal (set by admin)
  chatPinHash     String?
  chatPinRequired Boolean    @default(false)
  chatPinSetAt    DateTime?
  chatPinFailures Int        @default(0)
  chatPinLockedUntil DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sessions        Session[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]
  portal          Portal?    @relation(fields: [portalId], references: [id])

  @@map("users")
}

model Portal {
  id              String   @id @default(cuid())
  hubspotPortalId String   @unique
  name            String
  accessToken     String   // Encrypted HubSpot access token
  refreshToken    String   // Encrypted HubSpot refresh token
  tokenExpiresAt  DateTime
  connectedById   String   // userId of admin who connected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]

  @@map("portals")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id               String      @id @default(cuid())
  userId           String
  userEmail        String
  action           AuditAction
  toolName         String
  inputSummary     String
  outputSummary    String?
  recordType       String?
  recordId         String?
  status           LogStatus   @default(PENDING)
  requiresApproval Boolean     @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  messages  Json     @default("[]")
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model GovernanceRule {
  id          String     @id @default(cuid())
  name        String
  description String?
  toolName    String
  action      RuleAction
  conditions  Json?
  appliesTo   UserRole[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("governance_rules")
}

enum UserRole {
  ADMIN
  POWER_USER
  VIEWER
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
}

enum RuleAction {
  ALLOW
  REQUIRE_CONFIRM
  BLOCK
}

enum LogStatus {
  PENDING
  COMPLETED
  APPROVED
  REJECTED
  BLOCKED
}

model SensitivityRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  pattern     String
  category    SensitivityCategory
  maskStyle   MaskStyle @default(FULL)
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sensitivity_rules")
}

enum SensitivityCategory {
  EMAIL
  PHONE
  SSN
  CREDIT_CARD
  API_KEY
  CUSTOM
}

enum MaskStyle {
  FULL
  PARTIAL
  REDACT
}

model IpAllowlistEntry {
  id          String   @id @default(cuid())
  cidr        String
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ip_allowlist")
}

model SecurityEvent {
  id          String            @id @default(cuid())
  userId      String?
  userEmail   String?
  eventType   SecurityEventType
  detail      String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

enum SecurityEventType {
  PIN_VERIFIED
  PIN_FAILED
  PIN_LOCKED_OUT
  PIN_UNLOCKED
  PIN_SET
  PIN_CHANGED
  PIN_RESET_BY_ADMIN
  PIN_REMOVED
  CHAT_LOCKED
  CHAT_UNLOCKED
  IP_BLOCKED
  SESSION_EXPIRED
  EXPORT_BLOCKED
  BULK_ACCESS_BLOCKED
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  PORTAL_CONNECTED
  PORTAL_DISCONNECTED
  USER_REGISTERED
}

model SensitiveField {
  id          String       @id @default(cuid())
  objectType  String
  fieldName   String
  label       String
  maskStyle   MaskStyle    @default(PARTIAL)
  minRole     UserRole     @default(ADMIN)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([objectType, fieldName])
  @@map("sensitive_fields")
}

model DataRetentionPolicy {
  id                    String   @id @default(cuid())
  chatSessionMaxDays    Int      @default(90)
  auditLogMaxDays       Int      @default(365)
  securityEventMaxDays  Int      @default(365)
  isActive              Boolean  @default(true)
  lastRunAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("data_retention_policies")
}
